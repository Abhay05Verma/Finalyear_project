{
  "name": "landslide-ews-backend",
  "version": "1.0.0",
  "description": "Backend for Landslide Early Warning System Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/databaseSeeder.js",
    "cron:fetch": "node scripts/fetchDataCron.js",
    "cron:alerts": "node scripts/checkAlertsCron.js",
    "ai:train": "python ai/train_model.py --dataset ai/data/landslide_dataset.csv --output ai/landslide_model.pkl --metrics-output ai/training_metrics.json --cv-folds 3",
    "ai:predict:sample": "python ai/predict.py --model ai/landslide_model.pkl 40 80 6 5 2.5 28 1000"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.10.1",
    "sequelize": "^6.32.1",
    "socket.io": "^4.7.2",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
